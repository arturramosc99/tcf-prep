# TCF Prep environment variables. Copy to .env.local for local development (never commit .env.local).
# On Vercel, set them in Project → Settings → Environment Variables, for Production AND Preview.

# --- Required on Vercel ---------------------------------------------------------------------------
# Postgres. The Neon integration (Storage → Neon) sets it for you. POSTGRES_URL is accepted too.
# Without it, the app uses a local PGlite database in .data/pglite (fine for local development).
DATABASE_URL=

# Long random secret (40+ characters) used to sign the login cookie and encrypt your API keys.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# --- Optional ------------------------------------------------------------------------------------
# API keys. Normally you paste them in the app (Settings), where they are tested and stored encrypted.
# If set here, they take priority over the ones saved in the app.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Replaces the password created on first visit (use it to reset a forgotten password, then remove it).
APP_PASSWORD=

# Models
TCF_MODEL=claude-sonnet-5-5
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin

# --- Advanced ------------------------------------------------------------------------------------
# One-time import of a history exported from another tool (folder with seed.json, outside the repo).
LEGACY_DIR=
# Local only: correct with a logged-in `claude` CLI when no Claude key is saved (uses your subscription).
CLAUDE_CLI_FALLBACK=

# --- Testing (set by playwright.config.ts; you don't need these) --------------------------------
# ANTHROPIC_BASE_URL=http://localhost:4999
# OPENAI_BASE_URL=http://localhost:4999/openai/v1
# CONSIGNES_BANK_LIMIT=1
# PGLITE_DIR=.data/e2e
# NEXT_DIST_DIR=.next-e2e
