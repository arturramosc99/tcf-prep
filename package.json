{
  "name": "tcf-prep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --import tsx --test --test-concurrency=1 \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "scan": "tsx scripts/scan.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "typecheck": "next typegen && tsc --noEmit",
    "screenshots": "SCREENSHOTS=1 playwright test --project=setup --project=screenshots"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@electric-sql/pglite": "^0.5.10",
    "@neondatabase/serverless": "^1.2.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "license": "MIT"
}
